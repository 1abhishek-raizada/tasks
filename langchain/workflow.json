        "jsCode": "const text = $('Get Google Doc').first().json.body.content;\nconst videoRegex = /(https?:\\/\\/(?:www\\.)?(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/)[a-zA-Z0-9_-]{11}|https?:\\/\\/[^\\s\"]+\\.m3u8)/g;\nconst links = text.match(videoRegex) || [];\nreturn links.map(link => {\n  return {\n    json: {\n      videoUrl: link\n    }\n  };\n});",
        "options": {}
